{
  "name": "software-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "prisma generate && next build",
    "start": "next start -p 4000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts --dev",
    "db:seed:dev": "tsx prisma/seed.ts --dev",
    "db:seed:prod": "tsx prisma/seed.ts --prod",
    "db:studio": "prisma studio",
    "setup": "docker compose up -d --wait && npx prisma generate && npx prisma db push && npx tsx prisma/seed.ts --dev",
    "setup:prod": "npx prisma generate && npx prisma db push && npx tsx prisma/seed.ts --prod"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}

# ============================================================================
# Software Hub — Environment Configuration Template
# Copy this file to `.env` for local development.
# Never commit real credentials or secrets to Git.
# ============================================================================

# Environment Mode: "development" | "production"
APP_ENV="development"

# PostgreSQL Connection String (Local Docker or Neon Serverless Postgres)
DATABASE_URL="postgresql://shamodha:shamodha_secret_pass@localhost:5432/shamodha_releases?schema=public"

# Admin Console Credentials (/admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_in_env"

# 64-character hex secret for signing HTTP-only Admin JWT cookies
AUTH_SECRET="replace_with_64_char_hex_jwt_signing_secret"

# Public Canonical Base URL
# Local Dev: http://localhost:4000
# Production: https://releases.shamodha.com
NEXT_PUBLIC_SITE_URL="http://localhost:4000"
